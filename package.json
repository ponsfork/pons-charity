{
  "name": "pons-charity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Robinhood Chain / pons.family charity bot — claims creator fees and forwards 100% to the cause the dev picks",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
