# pons-charity — copy to .env and fill in. .env is gitignored.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Private key of the CHARITY wallet 0x416C762f134B48Ef303bB0b8cAF7D1DB86F719d2
PRIVATE_KEY=0xREPLACE_ME
# true = simulate only. Flip to false to go live.
DRY_RUN=true
# Min claimable WETH (wei) before we claim. 0.0002 ETH default.
CH_MIN_FEE=200000000000000
CH_COLLECT_INTERVAL=60
CH_DB=charity.db
